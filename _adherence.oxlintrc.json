{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/core/**",
              "components/disclosure/**",
              "components/navigation/**",
              "components/scorecard/**",
              "slides/**",
              "ui_kits/marketing_site/**",
              "ui_kits/pro_shop/**",
              "ui_kits/sponsor_page/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|DM Sans|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Anton, DM Sans, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|align|children|style|key|ref|className|style|children)$/]",
        "message": "<AccentBand> doesn't accept that prop. Declared props: tone, align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:flag|forest)$/]",
        "message": "<AccentBand> tone must be one of 'flag' | 'forest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<AccentBand> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shape|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, shape, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:flag|forest|sand|bunker)$/]",
        "message": "<Badge> tone must be one of 'flag' | 'forest' | 'sand' | 'bunker'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill)$/]",
        "message": "<Badge> shape must be one of 'square' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|as|disabled|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, as, disabled, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|forest|ghost|ghostOnDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'forest' | 'ghost' | 'ghostOnDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ceremonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Ceremonial> doesn't accept that prop. Declared props: tone, size, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ceremonial'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:fairway|bunker|forest|cream)$/]",
        "message": "<Ceremonial> tone must be one of 'fairway' | 'bunker' | 'forest' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ceremonial'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Ceremonial> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|label|liveMessage|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: target, label, liveMessage, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hole'] > JSXAttribute > JSXIdentifier[name!=/^(?:hole|venue|par|href|key|ref|className|style|children)$/]",
        "message": "<Hole> doesn't accept that prop. Declared props: hole, venue, par, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='DuotoneImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|scrim|opacity|style|imgStyle|children|key|ref|className|style|children)$/]",
        "message": "<DuotoneImage> doesn't accept that prop. Declared props: src, alt, ratio, scrim, opacity, style, imgStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<EmailForm> doesn't accept that prop. Declared props: placeholder, cta, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rule|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: rule, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:bunker|fairway|cream)$/]",
        "message": "<Eyebrow> tone must be one of 'bunker' | 'fairway' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<FaqEntry> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|align|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: onDark, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Input> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|base|withWordmark|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: variant, size, base, withWordmark, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|cream|mono|lockup)$/]",
        "message": "<Mark> variant must be one of 'full' | 'cream' | 'mono' | 'lockup'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|soon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, soon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:photos|columns|height|style|key|ref|className|style|children)$/]",
        "message": "<PhotoStrip> doesn't accept that prop. Declared props: photos, columns, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|name|blurb|spec|price|sku|cta|ctaHref|onDark|reverse|style|key|ref|className|style|children)$/]",
        "message": "<ProductBand> doesn't accept that prop. Declared props: image, imageAlt, name, blurb, spec, price, sku, cta, ctaHref, onDark, reverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScorecardRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|strokes|tone|key|ref|className|style|children)$/]",
        "message": "<ScorecardRow> doesn't accept that prop. Declared props: label, note, strokes, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScorecardRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:good|best|penalty|neutral)$/]",
        "message": "<ScorecardRow> tone must be one of 'good' | 'best' | 'penalty' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subline|align|onDark|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, title, subline, align, onDark, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHead> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h2)$/]",
        "message": "<SectionHead> size must be one of 'display' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:creed|ceremonial|columns|fineLeft|tagline|base|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: creed, ceremonial, columns, fineLeft, tagline, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: onDark, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Stamp> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:shirt|shirtAlt|logo|charity|mission|learnHref|joinHref|joinLabel|style|key|ref|className|style|children)$/]",
        "message": "<TeamCard> doesn't accept that prop. Declared props: shirt, shirtAlt, logo, charity, mission, learnHref, joinHref, joinLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|speed|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: items, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|badgeTone|name|price|priceNote|includes|cta|ctaHref|ctaVariant|featured|style|key|ref|className|style|children)$/]",
        "message": "<TicketCard> doesn't accept that prop. Declared props: badge, badgeTone, name, price, priceNote, includes, cta, ctaHref, ctaVariant, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:flag|forest|sand|bunker)$/]",
        "message": "<TicketCard> badgeTone must be one of 'flag' | 'forest' | 'sand' | 'bunker'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute[name.name='ctaVariant'] > Literal[value!=/^(?:primary|forest|ghost)$/]",
        "message": "<TicketCard> ctaVariant must be one of 'primary' | 'forest' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|label|price|availability|benefits|style|key|ref|className|style|children)$/]",
        "message": "<TierCard> doesn't accept that prop. Declared props: accent, label, price, availability, benefits, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:flag|bunker|fairway)$/]",
        "message": "<TierCard> accent must be one of 'flag' | 'bunker' | 'fairway'."
      }
    ]
